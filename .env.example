# Kudzu Arts — environment
#
# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
# Only DATABASE_URL is required. Every other integration is optional —
# leaving a key blank switches off just that feature and logs a line
# saying so. Nothing crashes.


# ── Required ────────────────────────────────────────────────────────
# Railway's Postgres provides this automatically in production.
# Locally: postgres://user:password@localhost:5432/kudzu
DATABASE_URL=


# ── Where the app lives ─────────────────────────────────────────────
# Used to build absolute links in invite emails and Stripe redirects.
# No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
NODE_ENV=development


# ── Artwork storage ─────────────────────────────────────────────────
# Uploaded images live on disk, not in the database. In production this
# must point at a mounted Railway volume or the work vanishes on redeploy.
UPLOAD_DIR=.uploads
MAX_UPLOAD_MB=25


# ── Stripe ──────────────────────────────────────────────────────────
# Buyers pay artists directly through Connect; Kudzu's commission is
# taken in transit as an application fee. Artists cannot publish work
# until their Stripe account is connected — enforced in the database.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Kudzu's cut, as a plain number. 25 means 25%. Defaults to 25.
KUDZU_COMMISSION_PCT=25


# ── Google sign-in ──────────────────────────────────────────────────
# Still invite-only: a Google account with no invite is refused.
# Authorised redirect URI: <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Notifications to artists ────────────────────────────────────────
# Transactional mail via Resend — an artist is told when a piece sells and
# when someone asks about one. Without this, messages sit unread until they
# happen to log in. Leave blank and mail is simply off; nothing breaks.
#
# MAIL_FROM must be on the domain registered in Resend — kudzuarts.com,
# not send.kudzuarts.com. The `send` subdomain only holds the SPF and MX
# records Resend asks you to add; it is not a sending domain, and using
# it returns a 403.
RESEND_API_KEY=
MAIL_FROM=Kudzu Arts <notifications@kudzuarts.com>


# ── Newsletter ──────────────────────────────────────────────────────
# Broadcasts only — unrelated to the transactional mail above.
BUTTONDOWN_API_KEY=


# ── Print fulfilment ────────────────────────────────────────────────
LUMAPRINTS_API_KEY=
LUMAPRINTS_API_SECRET=
LUMAPRINTS_STORE_ID=
LUMAPRINTS_API_BASE=


# ── Admin seeding ───────────────────────────────────────────────────
# Read only by `npm run seed`, which creates or promotes the two admin
# accounts. Pass them inline rather than storing them here:
#
#   IAN_PASSWORD=... ANDREW_PASSWORD=... npm run seed
